generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  password        String
  role            String      @default("EDITOR")
  universityId    String?
  isPlatformAdmin Boolean     @default(false)
  title           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  university      University? @relation(fields: [universityId], references: [id])
  userRoles       UserRole[]

  @@index([universityId])
}

// --- Multi-tenancy + RBAC (Phase 1: additive, nullable tenant columns) ---

model University {
  id           String        @id @default(cuid())
  nameAr       String
  nameEn       String
  slug         String        @unique
  domain       String?       @unique
  logo         String?
  isActive     Boolean       @default(true)
  settings     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  faculties    Faculty[]
  departments  Department[]
  users        User[]
  roles        Role[]
  featureFlags FeatureFlag[]

  @@index([slug])
}

model Faculty {
  id           String       @id @default(cuid())
  universityId String
  nameAr       String
  nameEn       String
  dean         String?
  order        Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departments  Department[]

  @@index([universityId])
}

model Role {
  id           String           @id @default(cuid())
  universityId String?
  key          String
  nameAr       String
  nameEn       String
  description  String?
  isSystem     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  university   University?      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]

  @@unique([universityId, key])
  @@index([universityId])
}

model Permission {
  id            String           @id @default(cuid())
  key           String           @unique
  resource      String
  action        String
  descriptionAr String?
  descriptionEn String?
  roles         RolePermission[]

  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  facultyId    String?
  departmentId String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, facultyId, departmentId])
  @@index([userId])
  @@index([roleId])
}

model FeatureFlag {
  id           String      @id @default(cuid())
  universityId String?
  key          String
  enabled      Boolean     @default(false)
  config       Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, key])
  @@index([universityId])
}

model AuditLog {
  id           String   @id @default(cuid())
  universityId String?
  actorUserId  String?
  action       String
  targetType   String?
  targetId     String?
  metadata     Json?
  ip           String?
  userAgent    String? // ClientR3: device/browser for the login & action audit report
  createdAt    DateTime @default(now())

  @@index([universityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
}

// ClientR3: periodic KPI/metric snapshots → multi-year trends + instant dashboards (nightly cron).
model KpiSnapshot {
  id           String   @id @default(cuid())
  universityId String?
  metric       String // e.g. "students.total" | "pass.rate" | "revenue.month" | …
  dimension    String? // optional breakdown key (programId/departmentId/level/term)
  period       String // "2025" | "2025-09" | "2024-2025|first" …
  value        Float
  capturedAt   DateTime @default(now())

  @@unique([universityId, metric, dimension, period])
  @@index([universityId, metric])
}

model Department {
  id               String            @id @default(cuid())
  nameAr           String
  nameEn           String
  description      String?
  image            String?
  head             String?
  order            Int               @default(0)
  isActive         Boolean           @default(true)
  facultyId        String?
  universityId     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  results          Result[]
  schedules        Schedule[]
  specializations  Specialization[]
  students         Student[]
  courses          Course[]
  instructors      Instructor[]
  programs         Program[]
  transferRequests TransferRequest[]
  faculty          Faculty?          @relation(fields: [facultyId], references: [id])
  university       University?       @relation(fields: [universityId], references: [id])

  @@index([facultyId])
  @@index([universityId])
}

model Specialization {
  id           String     @id @default(cuid())
  departmentId String
  nameAr       String
  nameEn       String
  year         Int
  description  String?
  order        Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

model Result {
  id            String          @id @default(cuid())
  departmentId  String
  year          Int
  semester      String
  academicYear  String
  pdfUrl        String?
  isVisible     Boolean         @default(false)
  allowView     Boolean         @default(true)
  allowDownload Boolean         @default(true)
  publishDate   DateTime?
  expiryDate    DateTime?
  universityId  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  department    Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students      StudentResult[]

  @@index([departmentId])
  @@index([universityId])
}

model StudentResult {
  id          String   @id @default(cuid())
  resultId    String
  studentId   String
  studentName String
  gpa         Float
  grade       String
  status      String
  createdAt   DateTime @default(now())
  result      Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([studentId])
}

model Schedule {
  id            String     @id @default(cuid())
  departmentId  String
  year          Int
  semester      String
  academicYear  String
  pdfUrl        String?
  isVisible     Boolean    @default(false)
  allowView     Boolean    @default(true)
  allowDownload Boolean    @default(true)
  publishDate   DateTime?
  expiryDate    DateTime?
  universityId  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lectures      Lecture[]
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([universityId])
}

model Lecture {
  id         String   @id @default(cuid())
  scheduleId String
  day        String
  startTime  String
  endTime    String
  course     String
  instructor String
  room       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

model News {
  id           String    @id @default(cuid())
  titleAr      String
  titleEn      String
  contentAr    String
  contentEn    String
  image        String?
  category     String    @default("NEWS")
  isFeatured   Boolean   @default(false)
  isInTicker   Boolean   @default(false)
  isPublished  Boolean   @default(false)
  publishDate  DateTime?
  order        Int       @default(0)
  views        Int       @default(0)
  universityId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPublished])
  @@index([isFeatured])
  @@index([isInTicker])
  @@index([universityId])
}

model Application {
  id                String   @id @default(cuid())
  fullName          String
  nationalId        String   @unique
  birthDate         DateTime
  phone             String
  email             String
  address           String
  highSchoolGrade   Float
  highSchoolYear    Int
  firstChoice       String
  secondChoice      String?
  thirdChoice       String?
  documentsUrl      String?
  status            String   @default("PENDING")
  notes             String?
  // ClientR3 reporting gap fields (additive)
  rejectionReason   String? // → "most-common rejection reasons" report
  qualificationType String? // ثانوية عامة | مدارس فنية → "accepted by qualification"
  documentsComplete Boolean  @default(false) // → "incomplete files count"
  universityId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([universityId])
}

model Complaint {
  id           String    @id @default(cuid())
  studentName  String
  studentId    String?
  email        String?
  phone        String
  type         String
  subject      String
  message      String
  attachments  String?
  status       String    @default("PENDING")
  response     String?
  respondedAt  DateTime?
  universityId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([universityId])
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  subject      String
  message      String
  isRead       Boolean  @default(false)
  response     String?
  universityId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isRead])
  @@index([universityId])
}

model Page {
  id             String        @id @default(cuid())
  titleAr        String
  titleEn        String
  slug           String        @unique
  contentAr      String?
  contentEn      String?
  parentId       String?
  level          Int           @default(1)
  showInHeader   Boolean       @default(false)
  showInFooter   Boolean       @default(false)
  isPublished    Boolean       @default(false)
  order          Int           @default(0)
  metaTitle      String?
  metaDesc       String?
  metaKeywords   String?
  ogImage        String?
  template       String        @default("blank")
  customCSS      String?
  customJS       String?
  currentVersion Int           @default(1)
  universityId   String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      String?
  updatedBy      String?
  parent         Page?         @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       Page[]        @relation("PageHierarchy")
  blocks         PageBlock[]
  versions       PageVersion[]

  @@index([slug])
  @@index([isPublished])
  @@index([parentId])
  @@index([showInHeader])
  @@index([showInFooter])
  @@index([universityId])
}

model PageBlock {
  id            String   @id @default(cuid())
  pageId        String
  type          String
  content       String
  settings      String
  order         Int      @default(0)
  parentBlockId String?
  desktop       String?
  tablet        String?
  mobile        String?
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([order])
  @@index([type])
}

model PageVersion {
  id         String   @id @default(cuid())
  pageId     String
  version    Int
  title      String
  blocksData String
  comment    String?
  createdBy  String?
  createdAt  DateTime @default(now())
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId])
}

model WidgetTemplate {
  id           String   @id @default(cuid())
  name         String
  type         String
  thumbnail    String?
  data         String
  category     String   @default("general")
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  universityId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([universityId])
}

model StudyPlanItem {
  id           String  @id @default(cuid())
  programId    String?
  programName  String
  year         String // "السنة الأولى"
  semester     String // "الفصل الأول"
  courseCode   String
  courseName   String
  hours        Int     @default(3)
  order        Int     @default(0)
  universityId String?

  @@index([programId])
  @@index([universityId])
}

model ExamCommittee {
  id           String        @id @default(cuid())
  name         String
  department   String?
  head         String?
  members      Int           @default(0)
  courses      Int           @default(0)
  status       String        @default("active") // active | pending
  universityId String?
  createdAt    DateTime      @default(now())
  tasks        ControlTask[]

  @@index([universityId])
}

model ControlTask {
  id           String         @id @default(cuid())
  committeeId  String?
  title        String
  status       String         @default("pending") // pending | inprogress | done
  assignee     String?
  universityId String?
  createdAt    DateTime       @default(now())
  committee    ExamCommittee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)

  @@index([committeeId])
  @@index([universityId])
}

model QualityIndicator {
  id           String  @id @default(cuid())
  name         String
  score        Int     @default(0)
  target       Int     @default(0)
  order        Int     @default(0)
  universityId String?

  @@index([universityId])
}

model Partnership {
  id           String    @id @default(cuid())
  name         String
  type         String?
  contact      String?
  phone        String?
  email        String?
  website      String?
  trainees     Int       @default(0)
  programs     Int       @default(0)
  status       String    @default("active")
  since        DateTime?
  universityId String?
  createdAt    DateTime  @default(now())

  @@index([universityId])
}

model Trainee {
  id           String    @id @default(cuid())
  name         String
  phone        String?
  email        String?
  program      String?
  batch        String?
  progress     Int       @default(0)
  attendance   Int       @default(0)
  status       String    @default("active")
  joinDate     DateTime?
  certificates Int       @default(0)
  universityId String?
  createdAt    DateTime  @default(now())

  @@index([universityId])
}

model Trainer {
  id             String   @id @default(cuid())
  name           String
  specialty      String?
  phone          String?
  email          String?
  courses        Int      @default(0)
  trainees       Int      @default(0)
  rating         Float    @default(0)
  status         String   @default("active")
  experience     String?
  certifications String[] @default([])
  universityId   String?
  createdAt      DateTime @default(now())

  @@index([universityId])
}

model Activity {
  id           String    @id @default(cuid())
  name         String
  members      Int       @default(0)
  type         String?
  nextEvent    String?
  date         DateTime?
  status       String    @default("active")
  universityId String?
  createdAt    DateTime  @default(now())

  @@index([universityId])
}

model Certificate {
  id               String    @id @default(cuid())
  code             String    @unique
  trainee          String
  program          String?
  issueDate        DateTime?
  status           String    @default("pending") // issued | pending
  verificationCode String?
  universityId     String?
  createdAt        DateTime  @default(now())

  @@index([universityId])
}

model MarketingCampaign {
  id           String    @id @default(cuid())
  name         String
  type         String?
  budget       Float     @default(0)
  spent        Float     @default(0)
  leads        Int       @default(0)
  conversions  Int       @default(0)
  status       String    @default("active")
  startDate    DateTime?
  endDate      DateTime?
  universityId String?
  createdAt    DateTime  @default(now())

  @@index([universityId])
}

model Message {
  id              String   @id @default(cuid())
  recipientUserId String // User.id of the inbox owner (any role)
  senderName      String
  senderRole      String? // e.g. "معلم الرياضيات" | "طالب" | "إدارة"
  subject         String
  body            String
  read            Boolean  @default(false)
  universityId    String?
  createdAt       DateTime @default(now())

  @@index([recipientUserId])
  @@index([read])
  @@index([universityId])
}

// Configurable result/grade states (client: "different result states per institute bylaw").
// Holds BOTH letter grades (A/B+/… with points) and special statuses (W/E/I/NE/FW/BL/DN/DS/TR/P/NP).
model GradeStatus {
  id            String  @id @default(cuid())
  universityId  String?
  code          String
  name          String // Arabic label
  points        Float? // GPA points; null for non-graded statuses (W/E/I)
  affectsGpa    Boolean @default(true) // included in CGPA when true
  isPass        Boolean @default(false) // counts toward earned/completed hours (= "Earn Credit")
  isLetter      Boolean @default(false) // true for A/B/C… letter grades (vs special statuses)
  minPercent    Int? // letter grades: lower %% bound used to map a numeric total → this letter
  // --- ClientR2: per-status policy properties (the "rules table") ---
  // The result engine reads these flags off the status row instead of hardcoding
  // behaviour per screen ("السيستم يقرأ خصائص الحالة ويقرر"). All configurable per institute.
  countsAttempt Boolean @default(true) // does this outcome count as a registration attempt at the course
  needsAction   Boolean @default(false) // result is PENDING until a follow-up action is completed (AB/INC/DEFER)
  nextAction    String? @default("NONE") // follow-up action code: MAKEUP_EXAM | COMPLETE_ASSESSMENT | REPEAT | NONE (canonical "no action" = "NONE", never null)
  isException   Boolean @default(false) // control-managed exceptional state (AB/ABS/INC/W/FW/DN/DEFER) vs system letter
  isFinal       Boolean @default(true) // false for non-terminal states that must resolve (INC/DEFER) before the result is settled
  order         Int     @default(0)

  @@unique([universityId, code])
  @@index([universityId])
}

// ClientR2: configurable reason catalogue — the "why" behind a result state, so the
// control/registrar can report "عدد الراسبين بسبب التحريري" vs "بسبب الغياب", and
// absence/withdrawal breakdowns. Referenced softly by Enrollment.reasonCode (mirrors
// the gradeStatusCode soft-reference pattern — no hard FK, keeps tenant config swappable).
model CourseResultReason {
  id           String   @id @default(cuid())
  universityId String?
  code         String // WrittenFail | AttendanceShortage | MedicalExcuse | WithdrawalRequest | DisciplinaryAction | Accident | ForceMajeure | Cheating …
  nameAr       String
  nameEn       String?
  category     String   @default("FAIL") // FAIL | ABSENCE | WITHDRAWAL | DISCIPLINARY | INCOMPLETE | OTHER
  appliesTo    String? // optional CSV of status codes this reason is valid for (e.g. "F,BL,DN"); null = any
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([universityId, code])
  @@index([universityId])
}

model Setting {
  id           String   @id @default(cuid())
  universityId String?
  key          String
  value        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([universityId, key])
  @@index([key])
}

// --- Student portal (grades vertical slice) ---

model Student {
  id                      String                     @id @default(cuid())
  userId                  String?                    @unique // forward-compat: link to NextAuth User/session later
  studentCode             String                     @unique // university/registration id
  nameAr                  String
  nameEn                  String?
  email                   String?                    @unique
  phone                   String?
  departmentId            String?
  level                   Int                        @default(1) // academic year/level
  gpa                     Float                      @default(0)
  status                  String                     @default("ACTIVE")
  enrollYear              Int?
  programId               String?
  // profile details
  nationalId              String?
  birthDate               DateTime?
  address                 String?
  section                 String? // e.g. "علمي رياضة" / specialization track
  advisorId               String? // academic advisor (Instructor) who approves registration
  // ClientR3 reporting gap fields (additive)
  holdStatus              Boolean                    @default(false) // registration hold (مالي/أكاديمي) → "students with Hold" report
  holdReason              String?
  source                  String? // admissions/marketing source (مصدر الطالب)
  entryQualification      String? // ثانوية عامة | مدارس فنية | … → qualification filter
  universityId            String?
  facultyId               String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  department              Department?                @relation(fields: [departmentId], references: [id])
  program                 Program?                   @relation(fields: [programId], references: [id])
  advisor                 Instructor?                @relation("AdvisorAdvisees", fields: [advisorId], references: [id])
  registrationRequests    RegistrationRequest[]
  enrollments             Enrollment[]
  attendances             Attendance[]
  feeAccounts             FeeAccount[]
  guardians               Guardian[]
  submissions             AssignmentSubmission[]
  scholarships            Scholarship[]
  appeals                 ExamAppeal[]
  warnings                StudentWarning[]
  gradRequests            GraduationRequest[]
  officeHoursAppointments OfficeHoursAppointment[]
  lessonProgress          LessonProgress[]
  pointsLog               PointsLog[]
  studentBadges           StudentBadge[]
  equivalenceRequests     CourseEquivalenceRequest[]
  transferRequests        TransferRequest[]
  examAttempts            ExamAttempt[]
  invoices                Invoice[]
  receipts                Receipt[]

  @@index([departmentId])
  @@index([studentCode])
  @@index([programId])
  @@index([universityId])
  @@index([facultyId])
}

model Course {
  id                  String                     @id @default(cuid())
  code                String                     @unique
  nameAr              String
  nameEn              String?
  creditHours         Int                        @default(3)
  departmentId        String?
  instructorId        String?
  // registrar flags (client bylaw requirements)
  countsInGpa         Boolean                    @default(true) // pass/fail subjects don't count toward CGPA
  requirementType     String                     @default("mandatory") // mandatory | elective (إجباري/اختياري)
  availableInSummer   Boolean                    @default(true)
  // grade-component caps that drive the per-subject breakdown in the UI
  midtermMax          Int                        @default(50)
  finalMax            Int                        @default(100)
  practicalMax        Int                        @default(0)
  homeworkMax         Int                        @default(20)
  isGraduationProject Boolean                    @default(false) // مشروع التخرج — gates graduation eligibility
  universityId        String?
  facultyId           String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  department          Department?                @relation(fields: [departmentId], references: [id])
  instructor          Instructor?                @relation(fields: [instructorId], references: [id])
  enrollments         Enrollment[]
  assignments         Assignment[]
  examSessions        ExamSession[]
  examQuestions       ExamQuestion[]
  appeals             ExamAppeal[]
  offerings           CourseOffering[]
  equivalenceRequests CourseEquivalenceRequest[]
  // prerequisite self-relation (registration validation)
  prerequisites       Course[]                   @relation("CoursePrereq")
  prerequisiteFor     Course[]                   @relation("CoursePrereq")

  @@index([departmentId])
  @@index([instructorId])
  @@index([universityId])
  @@index([facultyId])
}

// A course offered in a specific term; holds one or more sections (شُعب).
model CourseOffering {
  id           String    @id @default(cuid())
  courseId     String
  academicYear String
  semester     String // first | second | summer
  status       String    @default("open") // open | closed
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections     Section[]

  @@unique([courseId, academicYear, semester])
  @@index([academicYear, semester])
}

// A schedulable section of an offering that a student registers into.
model Section {
  id           String             @id @default(cuid())
  offeringId   String
  code         String // e.g. "ش1"
  instructorId String?
  capacity     Int                @default(30)
  day          String? // sun | mon | tue | wed | thu
  startMin     Int? // minutes from midnight (time-conflict checks)
  endMin       Int?
  room         String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  offering     CourseOffering     @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  instructor   Instructor?        @relation(fields: [instructorId], references: [id])
  items        RegistrationItem[]

  @@index([offeringId])
  @@index([instructorId])
}

// A student's registration request for a term — moves through the approval workflow.
model RegistrationRequest {
  id           String             @id @default(cuid())
  studentId    String
  academicYear String
  semester     String
  status       String             @default("Draft") // Draft|Submitted|Pending|Approved|Rejected|Returned|Cancelled
  advisorId    String? // the instructor (advisor) who decides
  note         String? // advisor note / rejection reason
  decidedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  advisor      Instructor?        @relation("AdvisorRequests", fields: [advisorId], references: [id])
  items        RegistrationItem[]

  @@unique([studentId, academicYear, semester])
  @@index([studentId])
  @@index([status])
  @@index([advisorId])
}

// One section line inside a registration request.
model RegistrationItem {
  id        String              @id @default(cuid())
  requestId String
  sectionId String
  request   RegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  section   Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([requestId, sectionId])
  @@index([requestId])
  @@index([sectionId])
}

model Enrollment {
  id                  String    @id @default(cuid())
  studentId           String
  courseId            String
  academicYear        String // e.g. "2024-2025"
  semester            String // "first" | "second"
  // recorded grade components (null = not yet graded)
  midterm             Float?
  final               Float?
  practical           Float?
  homework            Float?
  letterGrade         String?
  gradeStatusCode     String? // result-state code (A/B+/.../W/E/I/NE/FW/BL/DN/DS) → GradeStatus
  points              Float? // GPA points earned for this course
  status              String    @default("ENROLLED")
  resultLocked        Boolean   @default(false) // true once the result is approved & locked (اعتماد وغلق) — no further edits
  approvedAt          DateTime?
  // --- ClientR2: exceptional-case state machine (status → reason → action) ---
  reasonCode          String? // → CourseResultReason.code: WHY this state (WrittenFail/AttendanceShortage/MedicalExcuse…)
  attemptNo           Int       @default(1) // which attempt at this course (only countsAttempt outcomes increment it)
  resultPending       Boolean   @default(false) // a needsAction status not yet resolved → excluded from final GPA/credit calc
  actionType          String? // pending follow-up: MAKEUP_EXAM | COMPLETE_ASSESSMENT
  actionDueDate       DateTime? // bylaw deadline for the follow-up (الأسبوع الأول/الثاني من الترم التالي)
  actionResolvedAt    DateTime? // when the follow-up (makeup exam / completed assessment) was recorded
  statusSetBy         String? // userId of the executor (control) who set the exceptional status
  statusApprovalState String? // null | PENDING | APPROVED | REJECTED — two-step approval for exceptional states
  statusApprovedBy    String? // userId of the approver (control head / student affairs)
  statusApprovedAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, academicYear, semester])
  @@index([studentId])
  @@index([courseId])
  @@index([resultPending]) // ClientR2: open-action queue + report scans
  @@index([statusApprovalState]) // ClientR2: pending-approval queue scans
}

model Attendance {
  id           String   @id @default(cuid())
  studentId    String
  courseId     String? // per-course attendance (null = legacy/day-level); no FK at test scope
  academicYear String?
  semester     String?
  date         DateTime
  status       String   @default("present") // present | absent | late
  note         String?
  createdAt    DateTime @default(now())
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, date])
  @@index([studentId])
  @@index([courseId])
  @@index([date])
}

model FeeAccount {
  id           String    @id @default(cuid())
  studentId    String
  academicYear String
  totalFees    Float     @default(0)
  totalFeesDec Decimal?  @db.Decimal(18, 4) // finance P0: Decimal shadow of totalFees (migration target)
  installments Int       @default(1)
  universityId String? // finance P0: tenant scoping (backfilled from Student→Department→University)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items        FeeItem[]
  payments     Payment[]

  @@unique([studentId, academicYear])
  @@index([studentId])
  @@index([universityId])
}

model FeeItem {
  id           String     @id @default(cuid())
  accountId    String
  label        String
  amount       Float
  amountDec    Decimal?   @db.Decimal(18, 4) // finance P0: Decimal shadow
  universityId String? // finance P0: tenant scoping (inherited from account)
  account      FeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([universityId])
}

model Payment {
  id           String     @id @default(cuid())
  accountId    String
  amount       Float
  amountDec    Decimal?   @db.Decimal(18, 4) // finance P0: Decimal shadow
  method       String? // بطاقة ائتمان | فوري | محفظة إلكترونية
  receipt      String?
  status       String     @default("pending") // paid | pending | overdue
  dueDate      DateTime?
  paidAt       DateTime?
  universityId String? // finance P0: tenant scoping (inherited from account)
  createdAt    DateTime   @default(now())
  account      FeeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status])
  @@index([universityId])
}

model Guardian {
  id          String   @id @default(cuid())
  studentId   String
  userId      String? // parent login account (User with role PARENT); shared across their children
  relation    String // "father" | "mother" | "guardian"
  name        String
  phone       String?
  job         String?
  bankAccount String? // ClientR3: guardian financial data report
  createdAt   DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([userId])
}

model ExamSession {
  id           String        @id @default(cuid())
  courseId     String
  title        String?
  examType     String        @default("final") // midterm | final | quiz
  date         DateTime
  startTime    String // "9:00 AM"
  durationMins Int           @default(120)
  hall         String?
  passingScore Int           @default(60) // percentage needed to pass
  totalPoints  Int? // optional cached total; otherwise summed from question points
  academicYear String        @default("2024-2025")
  semester     String        @default("first")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts     ExamAttempt[]

  @@index([courseId])
  @@index([date])
}

model ExamAppeal {
  id          String    @id @default(cuid())
  studentId   String
  courseId    String
  reason      String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  response    String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

model ExamQuestion {
  id            String               @id @default(cuid())
  courseId      String
  text          String
  type          String               @default("mcq") // mcq | essay | truefalse | short
  difficulty    String               @default("medium") // easy | medium | hard
  points        Int                  @default(10)
  correctAnswer String? // answer key for truefalse/short (never sent to the client)
  createdAt     DateTime             @default(now())
  course        Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  options       ExamQuestionOption[]

  @@index([courseId])
  @@index([type])
}

model Payroll {
  id            String    @id @default(cuid())
  employeeName  String
  role          String    @default("staff") // faculty | staff
  month         String // e.g. "نوفمبر 2024"
  baseSalary    Float
  baseSalaryDec Decimal?  @db.Decimal(18, 4) // finance P0: Decimal shadow
  deductions    Float     @default(0)
  deductionsDec Decimal?  @db.Decimal(18, 4) // finance P0: Decimal shadow
  netSalary     Float
  netSalaryDec  Decimal?  @db.Decimal(18, 4) // finance P0: Decimal shadow
  status        String    @default("pending") // completed | pending
  paidAt        DateTime?
  universityId  String?
  createdAt     DateTime  @default(now())

  @@index([month])
  @@index([status])
  @@index([universityId])
}

model BankAccount {
  id           String            @id @default(cuid())
  bankName     String
  accountNo    String
  accountType  String
  balance      Float             @default(0)
  balanceDec   Decimal?          @db.Decimal(18, 4) // finance P0: Decimal shadow
  universityId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions BankTransaction[]

  @@index([universityId])
}

model BankTransaction {
  id          String      @id @default(cuid())
  accountId   String
  date        DateTime
  description String
  type        String // credit | debit
  amount      Float
  amountDec   Decimal?    @db.Decimal(18, 4) // finance P0: Decimal shadow
  reference   String?
  createdAt   DateTime    @default(now())
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// ===== Finance v2 — Phase 0 foundations (additive; engine in lib/finance/*) =====

model FiscalYear {
  id           String             @id @default(cuid())
  universityId String?
  code         String // e.g. "2025" or "2024-2025"
  startDate    DateTime
  endDate      DateTime
  status       String             @default("OPEN") // OPEN | CLOSING | CLOSED
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  periods      AccountingPeriod[]

  @@unique([universityId, code])
  @@index([universityId])
}

model AccountingPeriod {
  id           String         @id @default(cuid())
  universityId String?
  fiscalYearId String
  code         String // e.g. "2025-09"
  startDate    DateTime
  endDate      DateTime
  status       String         @default("OPEN") // OPEN | SOFT_CLOSED | CLOSED
  closedById   String?
  closedAt     DateTime?
  createdAt    DateTime       @default(now())
  fiscalYear   FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  entries      JournalEntry[]

  @@unique([fiscalYearId, code])
  @@index([universityId, status])
}

// Maker-checker dual-control for finance actions (journal post, payment/refund/payroll approve, period close).
model Approval {
  id            String    @id @default(cuid())
  universityId  String?
  entityType    String // JournalEntry | Payment | Refund | PayRun | Period | Bill | ExpenseClaim
  entityId      String
  action        String // post | approve | refund | close | pay
  state         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  @@index([universityId, entityType, state])
  @@index([entityType, entityId])
}

// Per-tenant, per-doc-type, per-fiscal-year atomic counter → gap-free official/legal numbers.
model DocumentSequence {
  id           String   @id @default(cuid())
  universityId String?
  docType      String // INVOICE | RECEIPT | CREDIT_NOTE | JOURNAL | EINVOICE | PAYRUN | BILL
  fiscalCode   String // fiscal-year code the sequence resets within
  prefix       String   @default("")
  nextNumber   Int      @default(1)
  padding      Int      @default(6)
  updatedAt    DateTime @updatedAt

  @@unique([universityId, docType, fiscalCode])
  @@index([universityId])
}

// Optional accounting dimension on journal lines (departments/programs/projects) for budgeting + reporting.
model CostCenter {
  id           String       @id @default(cuid())
  universityId String?
  code         String
  nameAr       String
  nameEn       String?
  parentId     String?
  // ClientR4: profitability roll-up dimensions. `type` classifies the centre; the optional
  // programId/facultyId/branchId (soft refs) let program/faculty/branch profitability reports roll
  // up the centres that belong to each. A centre with programId set = an academic profit centre.
  type         String       @default("ADMIN") // ACADEMIC | ADMIN | OPERATIONAL | BRANCH
  branchId     String?
  programId    String?
  facultyId    String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  parent       CostCenter?  @relation("CostCenterTree", fields: [parentId], references: [id])
  children     CostCenter[] @relation("CostCenterTree")

  @@unique([universityId, code])
  @@index([universityId])
}

// ClientR4: physical branch / campus — the location dimension for branch-comparison profitability.
model Branch {
  id           String   @id @default(cuid())
  universityId String?
  code         String
  nameAr       String
  nameEn       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([universityId, code])
  @@index([universityId])
}

// ===== Finance v2 — Phase 1: General Ledger (double-entry) =====

model ChartOfAccount {
  id           String           @id @default(cuid())
  universityId String?
  code         String // "1100"
  nameAr       String
  nameEn       String?
  type         String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  normalSide   String // DEBIT | CREDIT
  parentId     String?
  isPostable   Boolean          @default(true) // leaf accounts post; parents aggregate
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  parent       ChartOfAccount?  @relation("CoaTree", fields: [parentId], references: [id])
  children     ChartOfAccount[] @relation("CoaTree")
  lines        JournalLine[]

  @@unique([universityId, code])
  @@index([universityId, type])
}

// One balanced double-entry transaction. Every business event posts exactly one. Immutable once
// POSTED — corrections are reversing entries (reversesEntryId). Idempotent on (sourceType, sourceId).
model JournalEntry {
  id              String           @id @default(cuid())
  universityId    String?
  periodId        String
  entryNo         String // sequential per tenant (DocumentSequence JOURNAL)
  entryDate       DateTime
  memo            String?
  sourceType      String           @default("MANUAL") // MANUAL | OPENING | INVOICE | RECEIPT | REFUND | EXPENSE | PAYROLL | FX
  sourceId        String?
  status          String           @default("DRAFT") // DRAFT | POSTED | REVERSED
  createdById     String?
  postedById      String?
  postedAt        DateTime?
  reversesEntryId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  period          AccountingPeriod @relation(fields: [periodId], references: [id])
  lines           JournalLine[]
  reverses        JournalEntry?    @relation("EntryReversal", fields: [reversesEntryId], references: [id])
  reversedBy      JournalEntry[]   @relation("EntryReversal")

  @@unique([universityId, entryNo])
  @@index([universityId, sourceType, sourceId])
  @@index([periodId])
  @@index([status])
}

// One debit OR credit leg. Engine invariant (lib/finance/ledger.ts): SUM(debit)=SUM(credit) per entry.
model JournalLine {
  id           String         @id @default(cuid())
  entryId      String
  accountId    String
  debit        Decimal        @default(0) @db.Decimal(18, 4)
  credit       Decimal        @default(0) @db.Decimal(18, 4)
  memo         String?
  costCenterId String? // soft ref → CostCenter (no FK, like gradeStatusCode)
  entry        JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
}

// ===== Finance v2 — Phase 2: Accounts Receivable / student billing sub-ledger =====

// Reusable tariff template (per program/level/year). Instantiated into Invoices.
model FeeStructure {
  id           String             @id @default(cuid())
  universityId String?
  code         String
  nameAr       String
  nameEn       String?
  programId    String?
  level        Int?
  academicYear String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  items        FeeStructureItem[]

  @@unique([universityId, code])
  @@index([universityId])
}

model FeeStructureItem {
  id          String       @id @default(cuid())
  structureId String
  label       String
  accountCode String       @default("4100") // revenue ChartOfAccount code
  amount      Decimal      @db.Decimal(18, 4)
  vatRate     Int          @default(0) // %
  order       Int          @default(0)
  structure   FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId])
}

// AR document issued to a student. Sub-ledger primary record; posts Dr 1100 / Cr revenue (+ VAT).
model Invoice {
  id           String              @id @default(cuid())
  universityId String?
  studentId    String
  feeAccountId String? // soft link to the per-year FeeAccount control envelope
  structureId  String?
  number       String // sequential official number (DocumentSequence INVOICE)
  academicYear String?
  semester     String?
  issueDate    DateTime            @default(now())
  dueDate      DateTime?
  status       String              @default("DRAFT") // DRAFT | ISSUED | PARTIAL | PAID | VOID
  subtotal     Decimal             @default(0) @db.Decimal(18, 4)
  vatTotal     Decimal             @default(0) @db.Decimal(18, 4)
  total        Decimal             @default(0) @db.Decimal(18, 4)
  paid         Decimal             @default(0) @db.Decimal(18, 4)
  balance      Decimal             @default(0) @db.Decimal(18, 4)
  memo         String?
  etaUuid      String? // ETA e-invoice (Phase 4)
  etaStatus    String?
  createdById  String?
  costCenterId String? // ClientR4 profitability dimension (auto-derived from student's program)
  branchId     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lines        InvoiceLine[]
  allocations  ReceiptAllocation[]
  plan         InstallmentPlan?
  creditNotes  CreditNote[]

  @@unique([universityId, number])
  @@index([studentId])
  @@index([universityId, status])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  accountCode String  @default("4100")
  qty         Int     @default(1)
  unitPrice   Decimal @db.Decimal(18, 4)
  vatRate     Int     @default(0)
  lineTotal   Decimal @db.Decimal(18, 4)
  vatAmount   Decimal @default(0) @db.Decimal(18, 4)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InstallmentPlan {
  id           String        @id @default(cuid())
  universityId String?
  invoiceId    String        @unique
  count        Int
  createdAt    DateTime      @default(now())
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installments Installment[]
}

model Installment {
  id      String          @id @default(cuid())
  planId  String
  seq     Int
  dueDate DateTime
  amount  Decimal         @db.Decimal(18, 4)
  paid    Decimal         @default(0) @db.Decimal(18, 4)
  lateFee Decimal         @default(0) @db.Decimal(18, 4)
  status  String          @default("PENDING") // PENDING | PARTIAL | PAID | OVERDUE
  plan    InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// Cash-in document; posts Dr cash/bank/gateway / Cr 1100. Allocated across invoices/installments.
model Receipt {
  id           String              @id @default(cuid())
  universityId String?
  studentId    String
  number       String
  receiptDate  DateTime            @default(now())
  method       String              @default("CASH") // CASH | BANK | GATEWAY | SCHOLARSHIP
  amount       Decimal             @db.Decimal(18, 4)
  reference    String?
  etaUuid      String?
  createdById  String?
  costCenterId String? // ClientR4 profitability dimension (inherited from the paid invoice)
  branchId     String?
  createdAt    DateTime            @default(now())
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allocations  ReceiptAllocation[]

  @@unique([universityId, number])
  @@index([studentId])
}

model ReceiptAllocation {
  id            String  @id @default(cuid())
  receiptId     String
  invoiceId     String
  installmentId String?
  amount        Decimal @db.Decimal(18, 4)
  receipt       Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([invoiceId])
}

model CreditNote {
  id           String   @id @default(cuid())
  universityId String?
  invoiceId    String
  number       String
  creditDate   DateTime @default(now())
  amount       Decimal  @db.Decimal(18, 4)
  reason       String?
  createdById  String?
  createdAt    DateTime @default(now())
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([universityId, number])
  @@index([invoiceId])
}

// ===== Finance v2 — Phase 5: Accounts Payable / expenses sub-ledger =====

model Vendor {
  id              String   @id @default(cuid())
  universityId    String?
  code            String
  nameAr          String
  nameEn          String?
  taxRegNo        String?
  phone           String?
  email           String?
  withholdingRate Int      @default(0) // % deducted at payment → 2300 withholding payable
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bills           Bill[]

  @@unique([universityId, code])
  @@index([universityId])
}

// Vendor bill. Posts Dr expense / Cr 2100 (AP) on approval; payment posts Dr 2100 / Cr withholding+bank.
model Bill {
  id           String     @id @default(cuid())
  universityId String?
  vendorId     String
  number       String
  billDate     DateTime   @default(now())
  dueDate      DateTime?
  status       String     @default("DRAFT") // DRAFT | APPROVED | PAID | VOID
  subtotal     Decimal    @default(0) @db.Decimal(18, 4)
  vatTotal     Decimal    @default(0) @db.Decimal(18, 4)
  total        Decimal    @default(0) @db.Decimal(18, 4)
  paid         Decimal    @default(0) @db.Decimal(18, 4)
  balance      Decimal    @default(0) @db.Decimal(18, 4)
  memo         String?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  costCenterId String? // ClientR4 profitability dimension (which programme/faculty/branch bears this cost)
  branchId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  vendor       Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  lines        BillLine[]

  @@unique([universityId, number])
  @@index([vendorId])
  @@index([universityId, status])
}

model BillLine {
  id          String  @id @default(cuid())
  billId      String
  description String
  accountCode String  @default("5900") // expense ChartOfAccount code
  amount      Decimal @db.Decimal(18, 4)
  vatRate     Int     @default(0)
  bill        Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

model ExpenseCategory {
  id           String   @id @default(cuid())
  universityId String?
  code         String
  nameAr       String
  accountCode  String   @default("5900")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([universityId, code])
  @@index([universityId])
}

// Petty/staff expense claim (maker-checker). On pay: Dr expense / Cr bank.
model ExpenseClaim {
  id           String    @id @default(cuid())
  universityId String?
  claimantName String
  accountCode  String    @default("5900")
  description  String
  amount       Decimal   @db.Decimal(18, 4)
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | PAID
  claimDate    DateTime  @default(now())
  createdById  String?
  approvedById String?
  decidedAt    DateTime?
  costCenterId String? // ClientR4 profitability dimension
  branchId     String?
  createdAt    DateTime  @default(now())

  @@index([universityId, status])
}

// ===== Finance v2 — Phase 6: Payroll v2 =====

model Employee {
  id           String                    @id @default(cuid())
  universityId String?
  code         String
  nameAr       String
  nameEn       String?
  userId       String? // soft link to User (login)
  instructorId String? // soft link to Instructor
  jobTitle     String? // legacy denormalized label (kept for back-compat; jobTitleId is canonical)
  department   String? // legacy denormalized label (kept; adminDepartmentId is canonical)
  baseSalary   Decimal                   @default(0) @db.Decimal(18, 4)
  bankAccount  String?
  taxCardNo    String?
  insuranceNo  String?
  hireDate     DateTime?
  isActive     Boolean                   @default(true)
  // --- ClientR4 HR (R4c-1): 360 profile + org placement. Config entities (type/title/position/
  // dept/section/manager) are soft refs — resolved by lookup, like costCenterId/gradeStatusCode.
  nationalId        String?
  birthDate         DateTime?
  gender            String? // male | female
  maritalStatus     String?
  phone             String?
  email             String?
  address           String?
  employeeTypeId    String?
  jobTitleId        String?
  positionId        String?
  adminDepartmentId String?
  sectionId         String?
  managerId         String? // soft ref → Employee.id (direct manager)
  contractType      String? // permanent | temporary | partial | seasonal | consultant | fulltime_faculty | seconded_faculty
  contractStart     DateTime?
  contractEnd       DateTime?
  hrStatus          String                    @default("ACTIVE") // NEW|UNDER_REVIEW|ACCEPTED|PROBATION|SUSPENDED|INVESTIGATION|RESIGNED|TERMINATED|RETIRED|DECEASED|CONTRACT_ENDED
  iban              String?
  payMethod         String? // bank | cash | cheque
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  components     EmployeeSalaryComponent[]
  payslips       Payslip[]
  assignments    EmployeeAssignment[]
  qualifications EmployeeQualification[]
  experiences    EmployeeExperience[]
  documents      EmployeeDocument[]
  jobHistory     EmployeeJobHistory[]
  custody        AssetCustody[]

  @@unique([universityId, code])
  @@index([universityId])
  @@index([adminDepartmentId])
  @@index([employeeTypeId])
}

model SalaryComponent {
  id           String                    @id @default(cuid())
  universityId String?
  code         String
  nameAr       String
  kind         String // EARNING | DEDUCTION
  isTaxable    Boolean                   @default(true)
  isPercentage Boolean                   @default(false) // % of base salary
  defaultValue Decimal                   @default(0) @db.Decimal(18, 4)
  order        Int                       @default(0)
  isActive     Boolean                   @default(true)
  employees    EmployeeSalaryComponent[]

  @@unique([universityId, code])
  @@index([universityId])
}

model EmployeeSalaryComponent {
  id          String          @id @default(cuid())
  employeeId  String
  componentId String
  value       Decimal         @db.Decimal(18, 4)
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  component   SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([employeeId, componentId])
  @@index([employeeId])
}

// A monthly payroll run; posts Dr 5100 (salaries) / Cr 2400 (net payable) + Cr 2300 (tax/insurance/deductions).
model PayRun {
  id             String    @id @default(cuid())
  universityId   String?
  month          String // "2026-06"
  status         String    @default("DRAFT") // DRAFT | APPROVED | PAID
  runDate        DateTime  @default(now())
  grossTotal     Decimal   @default(0) @db.Decimal(18, 4)
  deductionTotal Decimal   @default(0) @db.Decimal(18, 4)
  taxTotal       Decimal   @default(0) @db.Decimal(18, 4)
  insuranceTotal Decimal   @default(0) @db.Decimal(18, 4)
  netTotal       Decimal   @default(0) @db.Decimal(18, 4)
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  costCenterId   String? // ClientR4 profitability dimension (optional cost centre bearing this run)
  branchId       String?
  createdAt      DateTime  @default(now())
  payslips       Payslip[]

  @@unique([universityId, month])
  @@index([universityId, status])
}

model Payslip {
  id         String        @id @default(cuid())
  payRunId   String
  employeeId String
  gross      Decimal       @db.Decimal(18, 4)
  deductions Decimal       @default(0) @db.Decimal(18, 4)
  tax        Decimal       @default(0) @db.Decimal(18, 4)
  insurance  Decimal       @default(0) @db.Decimal(18, 4)
  net        Decimal       @db.Decimal(18, 4)
  createdAt  DateTime      @default(now())
  payRun     PayRun        @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines      PayslipLine[]

  @@index([payRunId])
  @@index([employeeId])
}

model PayslipLine {
  id        String  @id @default(cuid())
  payslipId String
  label     String
  kind      String // EARNING | DEDUCTION | TAX | INSURANCE
  amount    Decimal @db.Decimal(18, 4)
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}

// ===== Finance v2 — Phase 4: ETA e-invoicing + tax =====

model TaxRate {
  id           String   @id @default(cuid())
  universityId String?
  code         String
  nameAr       String
  rateType     String // VAT | WITHHOLDING | TABLE_TAX
  rate         Decimal  @db.Decimal(9, 4) // percent
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([universityId, code])
  @@index([universityId])
}

// Egyptian Tax Authority fiscal document. Built from an issued Invoice/Receipt/CreditNote, then
// signed + submitted. Lines are SNAPSHOTTED (legal immutability). Submission is inert until creds.
model EInvoiceDocument {
  id             String         @id @default(cuid())
  universityId   String?
  sourceType     String // INVOICE | RECEIPT | CREDIT_NOTE
  sourceId       String
  internalId     String // our sequential legal number
  documentType   String         @default("I") // ETA doc type code
  status         String         @default("DRAFT") // DRAFT | SIGNED | SUBMITTED | VALID | REJECTED | CANCELLED
  uuid           String? // ETA-assigned UUID
  submissionUuid String?
  netAmount      Decimal        @default(0) @db.Decimal(18, 4)
  vatAmount      Decimal        @default(0) @db.Decimal(18, 4)
  totalAmount    Decimal        @default(0) @db.Decimal(18, 4)
  signedHash     String?
  signedAt       DateTime?
  submittedAt    DateTime?
  etaResponse    Json?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lines          EInvoiceLine[]

  @@unique([universityId, internalId])
  @@index([universityId, status])
  @@index([sourceType, sourceId])
}

model EInvoiceLine {
  id          String           @id @default(cuid())
  documentId  String
  description String
  quantity    Int              @default(1)
  unitPrice   Decimal          @db.Decimal(18, 4)
  netTotal    Decimal          @db.Decimal(18, 4)
  vatRate     Decimal          @default(0) @db.Decimal(9, 4)
  vatAmount   Decimal          @default(0) @db.Decimal(18, 4)
  total       Decimal          @db.Decimal(18, 4)
  document    EInvoiceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ===== Finance v2 — Phase 3: Payment gateway =====

// Non-secret per-tenant gateway registration (secrets live in Vercel env, never here).
model PaymentProviderConfig {
  id           String   @id @default(cuid())
  universityId String?
  provider     String // paymob | fawry | kashier
  mode         String   @default("sandbox") // sandbox | live
  merchantInfo Json? // non-secret ids (integration id, iframe id…)
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([universityId, provider])
  @@index([universityId])
}

// A hosted-checkout order we initiate BEFORE redirecting the payer. The authoritative amount.
model PaymentIntent {
  id             String               @id @default(cuid())
  universityId   String?
  studentId      String?
  invoiceId      String?
  provider       String
  amount         Decimal              @db.Decimal(18, 4)
  currency       String               @default("EGP")
  status         String               @default("CREATED") // CREATED | PENDING | PAID | FAILED | EXPIRED
  idempotencyKey String               @unique
  providerRef    String? // gateway order/intention id
  checkoutUrl    String?
  receiptId      String? // Receipt created on confirmation (sub-ledger link)
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  transactions   PaymentTransaction[]

  @@index([universityId, status])
  @@index([invoiceId])
}

// A provider-confirmed money event (webhook-sourced). Unique providerTxnId → idempotency.
model PaymentTransaction {
  id            String         @id @default(cuid())
  universityId  String?
  intentId      String?
  provider      String
  providerTxnId String
  amount        Decimal        @db.Decimal(18, 4)
  currency      String         @default("EGP")
  status        String // SUCCESS | FAILED | REFUNDED
  signatureHash String?
  createdAt     DateTime       @default(now())
  intent        PaymentIntent? @relation(fields: [intentId], references: [id])

  @@unique([provider, providerTxnId])
  @@index([universityId])
}

// Raw inbound webhook log — idempotency + replay protection + forensic audit.
model WebhookEvent {
  id           String   @id @default(cuid())
  universityId String?
  provider     String
  externalId   String? // provider event/txn id for dedup
  verified     Boolean  @default(false)
  outcome      String? // accepted | rejected:<reason>
  payload      Json?
  createdAt    DateTime @default(now())

  @@index([provider, externalId])
  @@index([createdAt])
}

// ===== Finance v2 — Phase 7: Treasury & budgeting =====

// Move money between two asset accounts (cash↔bank↔petty). Posts Dr to / Cr from.
model FundTransfer {
  id              String   @id @default(cuid())
  universityId    String?
  number          String
  fromAccountCode String
  toAccountCode   String
  amount          Decimal  @db.Decimal(18, 4)
  transferDate    DateTime @default(now())
  memo            String?
  createdById     String?
  createdAt       DateTime @default(now())

  @@unique([universityId, number])
  @@index([universityId])
}

// Summary bank reconciliation: statement balance vs the GL balance of a bank account as-of a date.
model BankReconciliation {
  id               String   @id @default(cuid())
  universityId     String?
  accountCode      String
  statementDate    DateTime
  statementBalance Decimal  @db.Decimal(18, 4)
  glBalance        Decimal  @db.Decimal(18, 4)
  difference       Decimal  @db.Decimal(18, 4)
  status           String   @default("OPEN") // OPEN | RECONCILED
  note             String?
  createdById      String?
  createdAt        DateTime @default(now())

  @@index([universityId])
}

model Budget {
  id           String       @id @default(cuid())
  universityId String?
  name         String
  fiscalCode   String
  status       String       @default("ACTIVE") // DRAFT | ACTIVE
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lines        BudgetLine[]

  @@unique([universityId, name])
  @@index([universityId])
}

model BudgetLine {
  id           String  @id @default(cuid())
  budgetId     String
  accountCode  String
  costCenterId String?
  amount       Decimal @db.Decimal(18, 4)
  budget       Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model Book {
  id           String      @id @default(cuid())
  title        String
  author       String?
  isbn         String?
  category     String?
  copies       Int         @default(1)
  available    Int         @default(1)
  universityId String?
  createdAt    DateTime    @default(now())
  borrowings   Borrowing[]

  @@index([category])
  @@index([universityId])
}

model Borrowing {
  id           String    @id @default(cuid())
  bookId       String
  borrowerName String
  studentId    String?
  borrowedAt   DateTime  @default(now())
  dueDate      DateTime
  returnedAt   DateTime?
  status       String    @default("borrowed") // borrowed | returned | overdue
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([status])
}

model LessonProgress {
  id          String    @id @default(cuid())
  studentId   String
  contentId   String // references LMSContent (no FK at test scope)
  status      String    @default("locked") // completed | current | locked
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, contentId])
  @@index([studentId])
}

model PointsLog {
  id        String   @id @default(cuid())
  studentId String
  points    Int
  reason    String
  category  String   @default("general") // assignment | attendance | grade | bonus
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([category])
}

model Badge {
  id            String         @id @default(cuid())
  name          String
  description   String?
  icon          String?
  category      String         @default("general")
  threshold     Int            @default(0) // points needed to earn
  universityId  String?
  studentBadges StudentBadge[]

  @@index([universityId])
}

model StudentBadge {
  id        String   @id @default(cuid())
  studentId String
  badgeId   String
  earnedAt  DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
  @@index([studentId])
}

model Reward {
  id           String   @id @default(cuid())
  name         String
  description  String?
  icon         String?
  cost         Int
  stock        Int      @default(0)
  universityId String?
  createdAt    DateTime @default(now())

  @@index([universityId])
}

model LMSContent {
  id           String   @id @default(cuid())
  courseId     String? // optional course link (no FK at test scope)
  unit         String? // module / chapter
  title        String
  type         String   @default("video") // video | pdf | image | audio
  url          String?
  sizeMb       Float?
  views        Int      @default(0)
  universityId String?
  createdAt    DateTime @default(now())

  @@index([type])
  @@index([universityId])
}

model ForumCategory {
  id           String       @id @default(cuid())
  name         String
  description  String?
  order        Int          @default(0)
  universityId String?
  createdAt    DateTime     @default(now())
  topics       ForumTopic[]

  @@index([universityId])
}

model ForumTopic {
  id         String        @id @default(cuid())
  categoryId String
  title      String
  authorName String
  authorRole String        @default("student")
  pinned     Boolean       @default(false)
  locked     Boolean       @default(false)
  answered   Boolean       @default(false)
  views      Int           @default(0)
  createdAt  DateTime      @default(now())
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  posts      ForumPost[]

  @@index([categoryId])
}

model ForumPost {
  id         String     @id @default(cuid())
  topicId    String
  authorName String
  authorRole String     @default("student")
  body       String
  likes      Int        @default(0)
  createdAt  DateTime   @default(now())
  topic      ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model VirtualClass {
  id           String   @id @default(cuid())
  courseId     String?
  title        String
  date         DateTime
  startTime    String
  durationMins Int      @default(60)
  platform     String   @default("zoom") // zoom | teams | meet
  status       String   @default("scheduled") // live | upcoming | scheduled | ended
  recordingUrl String?
  universityId String?
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([universityId])
}

model OfficeHoursSlot {
  id           String                   @id @default(cuid())
  instructorId String
  day          String // الأحد..
  startTime    String
  endTime      String
  location     String?
  type         String                   @default("in-person") // in-person | online
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  instructor   Instructor               @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  appointments OfficeHoursAppointment[]

  @@index([instructorId])
}

model OfficeHoursAppointment {
  id        String          @id @default(cuid())
  slotId    String
  studentId String
  date      DateTime
  topic     String?
  status    String          @default("pending") // pending | confirmed | cancelled
  createdAt DateTime        @default(now())
  slot      OfficeHoursSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([slotId])
  @@index([studentId])
}

model Publication {
  id           String     @id @default(cuid())
  instructorId String
  title        String
  venue        String? // journal / conference name
  year         Int?
  type         String     @default("journal") // journal | conference | book
  citations    Int        @default(0)
  impactFactor Float?
  status       String     @default("published") // published | under-review
  createdAt    DateTime   @default(now())
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
}

model StudentWarning {
  id         String    @id @default(cuid())
  studentId  String
  type       String    @default("ACADEMIC") // FIRST | SECOND | ACADEMIC | BEHAVIORAL
  reason     String
  gpa        Float?
  status     String    @default("ACTIVE") // ACTIVE | RESOLVED
  issuedAt   DateTime  @default(now())
  resolvedAt DateTime?
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model GraduationRequest {
  id             String    @id @default(cuid())
  studentId      String
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  completedHours Int       @default(0)
  requiredHours  Int       @default(132)
  gpa            Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reviewedAt     DateTime?
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model Scholarship {
  id           String   @id @default(cuid())
  studentId    String
  type         String // منحة | إعفاء
  amount       Float    @default(0)
  amountDec    Decimal? @db.Decimal(18, 4) // finance P0: Decimal shadow
  percentage   Int? // exemption percentage, if applicable
  academicYear String
  reason       String?
  status       String   @default("ACTIVE") // ACTIVE | ENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model Program {
  id               String      @id @default(cuid())
  nameAr           String
  nameEn           String?
  departmentId     String?
  degree           String? // بكالوريوس | دبلوم | ماجستير
  years            Int         @default(4)
  totalCreditHours Int         @default(0)
  description      String?
  isActive         Boolean     @default(true)
  universityId     String?
  facultyId        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  department       Department? @relation(fields: [departmentId], references: [id])
  students         Student[]

  @@index([departmentId])
  @@index([universityId])
  @@index([facultyId])
}

model Instructor {
  id              String                @id @default(cuid())
  userId          String?               @unique // login account (User with role FACULTY)
  name            String
  email           String?               @unique
  phone           String?
  title           String? // e.g. أستاذ مساعد
  departmentId    String?
  specialization  String?
  universityId    String?
  facultyId       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  department      Department?           @relation(fields: [departmentId], references: [id])
  courses         Course[]
  officeHours     OfficeHoursSlot[]
  publications    Publication[]
  advisees        Student[]             @relation("AdvisorAdvisees")
  sections        Section[]
  advisorRequests RegistrationRequest[] @relation("AdvisorRequests")

  @@index([departmentId])
  @@index([universityId])
  @@index([facultyId])
}

model Assignment {
  id          String                 @id @default(cuid())
  courseId    String
  title       String
  instructor  String?
  dueDate     DateTime
  maxGrade    Float                  @default(20)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([courseId])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String
  status       String     @default("pending") // pending | submitted | graded | late
  grade        Float?
  submittedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

// --- Online-exam taking: question options + per-student attempts/answers ---

// One selectable choice for an MCQ ExamQuestion. isCorrect is the answer key
// (used to auto-grade on submit; never exposed in the take-exam GET payload).
model ExamQuestionOption {
  id         String       @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
  createdAt  DateTime     @default(now())
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// A student's sitting of an ExamSession; one row per (student, session). Holds
// the computed result (replaces the old localStorage + mock calculateResults()).
model ExamAttempt {
  id              String       @id @default(cuid())
  examSessionId   String
  studentId       String
  status          String       @default("in_progress") // in_progress | submitted
  startedAt       DateTime     @default(now())
  submittedAt     DateTime?
  earnedPoints    Float?
  correctCount    Int?
  wrongCount      Int?
  unansweredCount Int?
  timeTakenSecs   Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  examSession     ExamSession  @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers         ExamAnswer[]

  @@unique([examSessionId, studentId])
  @@index([studentId])
  @@index([examSessionId])
}

// One per-question answer inside an attempt, plus the auto-grade verdict.
model ExamAnswer {
  id               String      @id @default(cuid())
  attemptId        String
  questionId       String
  answerText       String?
  selectedOptionId String?
  boolAnswer       Boolean?
  isCorrect        Boolean?
  awardedPoints    Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// --- Admission: course-equivalence (transfer credit) + transfer requests ---

// Transfer-credit request: maps an externally-taken course to a local Course
// the incoming transfer student wants credited. PENDING/APPROVED/REJECTED.
model CourseEquivalenceRequest {
  id                String    @id @default(cuid())
  studentId         String?
  studentName       String
  originalCourse    String // external course title
  originalInstitute String // previous institution
  requestedCourseId String?
  requestedCourse   String // denormalized label shown in the table
  creditHours       Int       @default(3)
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewerNote      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  reviewedAt        DateTime?
  universityId      String?
  student           Student?  @relation(fields: [studentId], references: [id])
  course            Course?   @relation(fields: [requestedCourseId], references: [id])

  @@index([status])
  @@index([studentId])
  @@index([universityId])
}

// Student transfer request — incoming (from external institution) or outgoing.
model TransferRequest {
  id            String      @id @default(cuid())
  direction     String // INCOMING | OUTGOING
  studentName   String
  studentId     String?
  institution   String // counterparty institution (source for INCOMING, dest for OUTGOING)
  departmentId  String?
  department    String? // denormalized department name fallback
  status        String      @default("PENDING") // PENDING | APPROVED | REJECTED | COMPLETED
  notes         String?
  universityId  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  student       Student?    @relation(fields: [studentId], references: [id])
  departmentRel Department? @relation(fields: [departmentId], references: [id])

  @@index([direction])
  @@index([status])
  @@index([universityId])
}

// ───────────────────────── Surveys & evaluations (ClientR3 — polish) ─────────────────────────
// Capture satisfaction / course-evaluation responses so the quality KPIs (faculty/student
// satisfaction, teaching effectiveness) compute from real data instead of the NO_DATA sentinel.
// IDs are stored as plain strings (no back-relations into Student/Instructor/Course) to keep this
// strictly additive — nothing existing changes.
model Survey {
  id           String           @id @default(cuid())
  universityId String?
  title        String
  type         String // STUDENT_SATISFACTION | FACULTY_SATISFACTION | COURSE_EVALUATION
  academicYear String?
  semester     String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  responses    SurveyResponse[]

  @@index([universityId])
  @@index([type])
  @@index([isActive])
}

model SurveyResponse {
  id             String   @id @default(cuid())
  surveyId       String
  survey         Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  universityId   String?
  respondentType String // STUDENT | FACULTY
  studentId      String?
  instructorId   String?
  courseId       String?
  rating         Int // 1..5 Likert
  comment        String?
  academicYear   String?
  semester       String?
  createdAt      DateTime @default(now())

  @@index([surveyId])
  @@index([universityId])
  @@index([courseId])
  @@index([instructorId])
}

// Faculty research output — feeds the "research productivity" KPI (outputs per active faculty).
// Empty table ⇒ the KPI stays NO_DATA; never fabricated.
model ResearchOutput {
  id           String    @id @default(cuid())
  universityId String?
  instructorId String?
  title        String
  kind         String    @default("JOURNAL") // JOURNAL | CONFERENCE | BOOK | PATENT | OTHER
  venue        String?
  academicYear String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([universityId])
  @@index([instructorId])
  @@index([academicYear])
}

// ═══════════════ ClientR4 — HR module (R4c-1): org structure + employee 360 profile ═══════════════

// Administrative department — distinct from the academic `Department`. Self-nesting; manager is a
// soft ref → Employee.id. isAcademic flags teaching-side admin units.
model AdminDepartment {
  id                String          @id @default(cuid())
  universityId      String?
  code              String
  nameAr            String
  nameEn            String?
  parentId          String?
  managerEmployeeId String?
  isAcademic        Boolean         @default(false)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  sections          AdminSection[]

  @@unique([universityId, code])
  @@index([universityId])
}

model AdminSection {
  id                String          @id @default(cuid())
  universityId      String?
  adminDepartmentId String
  code              String?
  nameAr            String
  nameEn            String?
  headEmployeeId    String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  adminDepartment   AdminDepartment @relation(fields: [adminDepartmentId], references: [id], onDelete: Cascade)

  @@index([adminDepartmentId])
  @@index([universityId])
}

// Employee category (أعضاء هيئة تدريس / هيئة معاونة / إداريين / عمال / أمن / فنيين / قيادات).
model EmployeeType {
  id           String   @id @default(cuid())
  universityId String?
  code         String
  nameAr       String
  order        Int      @default(0)
  isActive     Boolean  @default(true)

  @@unique([universityId, code])
  @@index([universityId])
}

// Job title with a level (سلم المسمى الوظيفي). isAcademic/isManagerial drive career-path + workflow.
model JobTitle {
  id             String   @id @default(cuid())
  universityId   String?
  code           String
  nameAr         String
  nameEn         String?
  employeeTypeId String?
  jobLevel       Int      @default(1)
  isAcademic     Boolean  @default(false)
  isManagerial   Boolean  @default(false)
  isActive       Boolean  @default(true)

  @@unique([universityId, code])
  @@index([universityId])
}

// Administrative position/appointment (رئيس قسم / مدير إدارة / وكيل / عميد / أمين عام) — distinct
// from JobTitle: a person holds a title AND may occupy a position.
model Position {
  id           String   @id @default(cuid())
  universityId String?
  code         String
  nameAr       String
  nameEn       String?
  isActive     Boolean  @default(true)

  @@unique([universityId, code])
  @@index([universityId])
}

// Dated placement of an employee (dept/section/title/position/manager). One row is current at a time.
model EmployeeAssignment {
  id                String    @id @default(cuid())
  employeeId        String
  adminDepartmentId String?
  sectionId         String?
  jobTitleId        String?
  positionId        String?
  managerEmployeeId String?
  startDate         DateTime  @default(now())
  endDate           DateTime?
  isCurrent         Boolean   @default(true)
  note              String?
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeQualification {
  id          String   @id @default(cuid())
  employeeId  String
  degree      String
  institution String?
  year        Int?
  grade       String?
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeExperience {
  id         String   @id @default(cuid())
  employeeId String
  employer   String
  title      String?
  years      Float?
  note       String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  type       String // NATIONAL_ID | BIRTH_CERT | QUALIFICATION | CONTRACT | PHOTO | OTHER
  name       String
  url        String?
  uploadedAt DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// Employment movement log (تعيين / ترقية / نقل / ندب …).
model EmployeeJobHistory {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime @default(now())
  action     String // HIRE | PROMOTION | TRANSFER | POSITION | SUSPEND | RETURN | END
  note       String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// Asset custody (عهدة) linked to the employee (laptop, phone, key, vehicle…).
model AssetCustody {
  id         String    @id @default(cuid())
  employeeId String
  item       String
  code       String?
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  note       String?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}
