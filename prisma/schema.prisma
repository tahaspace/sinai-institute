  name           String
  email          String?  @unique
  phone          String?
  title          String? // e.g. أستاذ مساعد
  departmentId   String?
  specialization String?
  universityId   String?
  facultyId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  department     Department? @relation(fields: [departmentId], references: [id])
