  courseId    String
  title       String
  instructor  String?
  dueDate     DateTime
  maxGrade    Float                  @default(20)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([courseId])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String
  status       String     @default("pending") // pending | submitted | graded | late
  grade        Float?
  submittedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

// --- Online-exam taking: question options + per-student attempts/answers ---

// One selectable choice for an MCQ ExamQuestion. isCorrect is the answer key
// (used to auto-grade on submit; never exposed in the take-exam GET payload).
model ExamQuestionOption {
  id         String       @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
  createdAt  DateTime     @default(now())
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// A student's sitting of an ExamSession; one row per (student, session). Holds
// the computed result (replaces the old localStorage + mock calculateResults()).
model ExamAttempt {
  id              String       @id @default(cuid())
  examSessionId   String
  studentId       String
  status          String       @default("in_progress") // in_progress | submitted
  startedAt       DateTime     @default(now())
  submittedAt     DateTime?
  earnedPoints    Float?
  correctCount    Int?
  wrongCount      Int?
  unansweredCount Int?
  timeTakenSecs   Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  examSession     ExamSession  @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers         ExamAnswer[]

  @@unique([examSessionId, studentId])
  @@index([studentId])
  @@index([examSessionId])
}

// One per-question answer inside an attempt, plus the auto-grade verdict.
model ExamAnswer {
  id               String      @id @default(cuid())
  attemptId        String
  questionId       String
  answerText       String?
  selectedOptionId String?
  boolAnswer       Boolean?
  isCorrect        Boolean?
  awardedPoints    Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// --- Admission: course-equivalence (transfer credit) + transfer requests ---

// Transfer-credit request: maps an externally-taken course to a local Course
// the incoming transfer student wants credited. PENDING/APPROVED/REJECTED.
model CourseEquivalenceRequest {
  id                String    @id @default(cuid())
  studentId         String?
  studentName       String
  originalCourse    String // external course title
  originalInstitute String // previous institution
  requestedCourseId String?
  requestedCourse   String // denormalized label shown in the table
  creditHours       Int       @default(3)
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewerNote      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  reviewedAt        DateTime?
  universityId      String?
  student           Student?  @relation(fields: [studentId], references: [id])
  course            Course?   @relation(fields: [requestedCourseId], references: [id])

  @@index([status])
  @@index([studentId])
  @@index([universityId])
}

// Student transfer request — incoming (from external institution) or outgoing.
model TransferRequest {
  id            String      @id @default(cuid())
  direction     String // INCOMING | OUTGOING
  studentName   String
  studentId     String?
  institution   String // counterparty institution (source for INCOMING, dest for OUTGOING)
  departmentId  String?
  department    String? // denormalized department name fallback
  status        String      @default("PENDING") // PENDING | APPROVED | REJECTED | COMPLETED
  notes         String?
  universityId  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  student       Student?    @relation(fields: [studentId], references: [id])
  departmentRel Department? @relation(fields: [departmentId], references: [id])

  @@index([direction])
  @@index([status])
  @@index([universityId])
}
